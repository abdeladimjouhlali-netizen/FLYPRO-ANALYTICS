# Local mode (backend + frontend only — no Docker, AI optional)
VITE_API_BASE_URL=http://localhost:8080
VITE_AI_BASE_URL=/ai-api
VITE_AI_TOASTS=false
VITE_ENABLE_AI=false
# DEV ONLY — ignore JWT / login UI. Restore with false + flypro.security.auth-enabled=true
VITE_AUTH_DISABLED=true
# Digital Twin (optionnel) — sinon MapLibre utilise un fond satellite gratuit
# VITE_MAPBOX_TOKEN=pk.xxx
