# =============================================================================
# FlyPro Analytics – Environment template
# Copy to `.env` and adapt values. Never commit real secrets.
# =============================================================================

# --- Ports (host) ---
FRONTEND_PORT=80
BACKEND_PORT=8080
AI_PORT=8000
MYSQL_PORT=3306
ADMINER_PORT=8081

# --- MySQL ---
MYSQL_DATABASE=flypro_analytics
MYSQL_USER=flypro
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# --- Spring Boot ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
DATABASE_URL=jdbc:mysql://mysql:3306/flypro_analytics?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=flypro
DATABASE_PASSWORD=change-me-db-password

# JWT (>= 32 characters for HS256)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=flypro-analytics

# Browser origins allowed by CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://127.0.0.1

# Internal AI base URL (backend → ai-service)
AI_SERVICE_URL=http://ai-service:8000

# --- Frontend build-time URLs (same-origin behind Nginx recommended) ---
VITE_API_BASE_URL=
VITE_AI_BASE_URL=/ai-api

# --- AI service ---
AI_LOG_LEVEL=INFO

# Rate limiting / brute-force (backend)
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_BRUTE_FORCE_MAX=5
AUTH_BRUTE_FORCE_LOCK_SECONDS=300

# HikariCP
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=5

# --- High Availability overlay (docker-compose.ha.yml) ---
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=flypro
RABBITMQ_PASSWORD=change-me-rabbit

# Optional API key gate (comma-separated keys)
API_KEY_ENABLED=false
API_KEYS=
API_KEY_PROTECTED_PREFIXES=/actuator/prometheus

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_TRACES_SAMPLER_ARG=0.1
