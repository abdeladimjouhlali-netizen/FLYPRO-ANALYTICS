# =============================================================================
# FlyPro Analytics – Dockerfile.frontend
# Rôle : build Vite/React puis servir les assets via nginx.
# =============================================================================

# --- Build ---
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend/ ./
RUN npm run build

# --- Runtime ---
FROM nginx:1.27-alpine
# Configuration nginx minimale — à affiner lors du déploiement
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
