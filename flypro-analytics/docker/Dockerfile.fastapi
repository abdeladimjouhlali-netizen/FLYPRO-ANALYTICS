# =============================================================================
# FlyPro Analytics – Dockerfile.fastapi
# Rôle : image Python pour le microservice IA (FastAPI + Uvicorn).
# =============================================================================

FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Dépendances système minimales (compilateurs si wheels absents)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY ai-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY ai-service/ .

EXPOSE 8000

# Point d'entrée : main:app (squelette health uniquement)
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
