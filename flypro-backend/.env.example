# =============================================================================
# Variables d'environnement – exemple (copier vers .env)
# Ne jamais committer de secrets réels.
# =============================================================================

SPRING_PROFILES_ACTIVE=dev

MYSQL_DATABASE=flypro_analytics
MYSQL_USER=flypro
MYSQL_PASSWORD=flypro
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

DATABASE_URL=jdbc:mysql://localhost:3306/flypro_analytics?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=flypro
DATABASE_PASSWORD=flypro

JWT_SECRET=dev-only-change-me-not-for-production-use-32b+
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=flypro-analytics

SERVER_PORT=8080
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
